{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Endings",
  "type": "object",
  "required": [
    "schemaVersion",
    "endings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "minLength": 3
          },
          "kind": {
            "enum": [
              "happy",
              "normal",
              "bad",
              "bittersweet",
              "hidden",
              "absurd"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "recapRules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "when",
                "text"
              ],
              "properties": {
                "when": {
                  "$ref": "#/$defs/condition"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "contains"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^(player\\.(species|combat|magic|gold|alive|legalStatus|crimes)|npcs\\.[a-z][a-z0-9_]*\\.(alive|combat|trust|affection|relationship)|flags|inventory\\.[a-z][a-z0-9_]*)$"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
