              "id": "out_route_rescue_middle_b_2",
              "weight": 1,
              "result": "mixed",
              "to": {
                "kind": "node",
                "id": "route_rescue_final_b"
              },
              "narrative": "그때의 결정은 훗날 마지막 선택을 앞두고 다시 떠올랐다.",
              "effects": [
                {
                  "op": "addToSet",
