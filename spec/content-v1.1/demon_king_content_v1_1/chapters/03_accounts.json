    {
      "id": "dk44_personal_reckoning",
      "kind": "scene",
      "age": 44,
      "title": "미나의 청첩장은 아니다",
      "body": "왕립 용사단이 공식 공문을 보냈다. 오래전 시험장의 안전규정 개정에 당신의 과거 진술이 필요하다는 내용이었다. 당시 사진에는 미나와 당신이 함께 찍혀 있었다. 개인 연락을 끊었던 미나는 이 공문에 사적인 말을 한 줄도 넣지 않았다.",
      "choices": [
        {
          "id": "give_statement",
          "text": "한 번만 공식 증언하고 미나와의 관계를 놓아준다.",
          "outcomes": [
            {
              "id": "out_dk49_reform_result",
              "weight": 1,
              "result": "mixed",
              "to": {
                "kind": "node",
                "id": "dk49_reform_result"
              },
              "effects": [
                {
                  "op": "addToSet",
                  "path": "flags",
                  "value": "final_mina_testimony"
                }
              ]
            }
          ],
          "description": "미나에게 가까워지는 길이 아니라 사건을 바로잡는 길."
        },
        {
          "id": "ask_for_photo_fee",
          "text": "사진 사용료 5만 금화를 요구한다.",
          "outcomes": [
            {
              "id": "out_dk49_life_result",
              "weight": 1,
              "result": "failure",
              "to": {
                "kind": "node",
                "id": "dk49_life_result"
              },
              "effects": [
                {
                  "op": "addToSet",
                  "path": "flags",
                  "value": "asked_mina_photo_fee"
                },
                {
                  "op": "set",
                  "path": "npcs.mina.trust",
                  "value": -95
                }
              ]
            }
          ],
          "description": "증명사진은 추억인데 사용료는 청구서다."
        },
        {
          "id": "burn_photo",
          "text": "사진을 태우고 왕국을 떠난다.",
          "outcomes": [
            {
              "id": "out_dk49_life_result",
              "weight": 1,
              "result": "neutral",
              "to": {
                "kind": "node",
                "id": "dk49_life_result"
              },
              "effects": [
                {
                  "op": "addToSet",
                  "path": "flags",
                  "value": "destroyed_old_photo"
                }
              ]
            }
          ],
          "description": "사진을 태워도 그날의 선택은 남는다."
        }
      ]
    },
    {
      "id": "dk44_erisia_alliance",
      "kind": "scene",
      "age": 44,
      "title": "왕녀와 국가 예산",
      "body": "에리시아는 비밀 회의에서 왕실 관리비 장부의 원본 열람을 제안했다. 그녀는 당신이 동업자든 배우자든 국왕의 딸이라는 사실이 자신에게 법적 면책을 주지 않는다고 경고했다.",
      "choices": [
        {
          "id": "seek_joint_audit",
          "text": "상호 보전된 장부와 증언을 바탕으로 공동 감사를 요청한다.",
          "outcomes": [
            {
              "id": "out_dk49_audit_chamber",
              "weight": 1,
              "result": "mixed",
              "to": {
                "kind": "node",
                "id": "dk49_audit_chamber"
              },
              "effects": [
                {
                  "op": "addToSet",
                  "path": "flags",
                  "value": "erisia_joint_audit"
                },
                {
                  "op": "set",
                  "path": "npcs.erisia.trust",
                  "value": 80
                }
              ]
            }
          ],
          "description": "왕녀와 마왕의 동업, 핵심 자산은 장부 사본."
        },
        {
          "id": "betray_her",
          "text": "에리시아를 반역 공모자로 몰아 자신의 지위를 높인다.",
          "outcomes": [
            {
              "id": "out_dk49_political_backlash",
              "weight": 1,
              "result": "failure",
              "to": {
                "kind": "node",
                "id": "dk49_political_backlash"
              },
              "effects": [
                {
                  "op": "addToSet",
                  "path": "flags",
                  "value": "betrayed_erisia_evidence"
                },
                {
                  "op": "set",
                  "path": "npcs.erisia.trust",
                  "value": -100
                }
              ]
            }
          ],
          "description": "배우자와 동업자를 동시에 잃을 수 있는 거래."
        },
        {
          "id": "try_child_king",
          "text": "\"아내가 왕녀니까 제 아이가 왕\"이라는 법률을 주장한다.",
