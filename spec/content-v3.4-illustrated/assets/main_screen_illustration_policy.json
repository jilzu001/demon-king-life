{
  "schemaVersion": 1,
  "feature": "story-main-screen-inline-illustrations",
  "enabled": true,
  "placement": {
    "mode": "inline-between-paragraphs",
    "primary": "after-opening-paragraph-before-choices",
    "never": [
      "inside-dialogue",
      "inside-choice-buttons",
      "inside-one-line-chronicle"
    ],
    "priority": [
      "event-specific",
      "character",
      "location"
    ],
    "maxImagesPerScene": 1,
    "showOnlyRelevant": true
  },
  "responsive": {
    "mobile": {
      "maxWidthPx": 480,
      "maxHeightPx": 240,
      "width": "100%"
    },
    "desktop": {
      "maxWidthPx": 680,
      "maxHeightPx": 360,
      "width": "min(100%, 680px)"
    },
    "objectFit": "contain",
    "avoidForcedCrop": true
  },
  "performance": {
    "loading": "lazy",
    "decoding": "async",
    "preloadOnlyFirstVisibleScene": true,
    "reserveAspectRatio": true,
    "useManifestPaths": true
  },
  "accessibility": {
    "altTextFromAssetLabels": true,
    "decorativeImagesMayUseEmptyAlt": true
  },
  "compatibility": {
    "preserveExistingStoryAndSaveSchema": true,
    "doNotAddCharactersFromAssetAliases": true,
    "fallbackWhenAssetMissing": "text-only"
  }
}