{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional presentation content for demon-king; not a logic schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "storyId",
    "storyVersion",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "storyId": {
      "const": "demon-king"
    },
    "storyVersion": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "chronicleSummary"
        ],
        "properties": {
          "chronicleSummary": {
            "type": "string",
            "minLength": 5
          },
          "locationLabel": {
            "type": "string",
            "minLength": 2
          },
          "dialogues": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "text"
              ],
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
