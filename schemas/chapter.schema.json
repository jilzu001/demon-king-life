{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story chapter",
  "type": "object",
  "required": [
    "schemaVersion",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "contains"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^(player\\.(species|combat|magic|gold|alive|legalStatus|crimes)|npcs\\.[a-z][a-z0-9_]*\\.(alive|combat|trust|affection|relationship)|flags|inventory\\.[a-z][a-z0-9_]*)$"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "effect": {
      "type": "object",
      "required": [
        "op",
        "path",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "set",
            "add",
            "addToSet",
            "removeFromSet"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(player\\.(species|combat|magic|gold|alive|legalStatus|crimes)|npcs\\.[a-z][a-z0-9_]*\\.(alive|combat|trust|affection|relationship)|flags|inventory\\.[a-z][a-z0-9_]*)$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "id",
        "weight",
        "result",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 3
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "success",
            "failure",
            "mixed",
            "neutral"
          ]
        },
        "to": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "node",
                "ending"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "minLength": 3
            }
          },
          "additionalProperties": false
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      },
      "additionalProperties": false
    },
    "chronicle": {
      "type": "object",
      "required": [
        "age",
        "text"
      ],
      "properties": {
        "age": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "presence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "minLength": 3
          }
        },
        "reference": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "minLength": 3
          }
        },
        "flashback": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "minLength": 3
          }
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": [
        "id",
        "text",
        "outcomes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "enabledWhen": {
          "$ref": "#/$defs/condition"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "age",
        "title",
        "body",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 3
        },
        "kind": {
          "const": "scene"
        },
        "age": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "chronicle": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chronicle"
          }
        },
        "entryEffects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
